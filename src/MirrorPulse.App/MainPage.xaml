<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MirrorPulse.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MirrorPulse.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="20" Padding="32,48">
            <TextBlock Text="Welcome to MirrorPulse" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Connect your storage adapters and keep your files available in one Cloud Files location." TextWrapping="Wrap" />
            <InfoBar IsOpen="True" Severity="Informational" Title="Your data stays local" Message="MirrorPulse does not collect usage data or upload diagnostics." />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="GetStartedButton" Content="Get started" Click="GetStartedButton_Click" />
                <TextBlock x:Name="StartupStatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

