<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MirrorPulse.App.AdapterUpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="16" Padding="32" MaxWidth="760">
        <TextBlock Text="Adapter updates" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="Update each installed Adapter independently while preserving its configured instances." TextWrapping="Wrap" />
        <Grid ColumnSpacing="24" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Installed version" />
            <TextBlock Grid.Column="1" x:Name="InstalledVersionText" Text="—" />
            <TextBlock Grid.Row="1" Text="Latest version" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LatestVersionText" Text="—" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="CheckForUpdatesButton" Content="Check for updates" Click="CheckForUpdatesButton_Click" />
            <Button x:Name="UpdateButton" Content="Update" IsEnabled="False" Click="UpdateButton_Click" />
        </StackPanel>
        <InfoBar x:Name="UpdateStatusBar" IsOpen="False" Severity="Informational" />
    </StackPanel>
</Page>
