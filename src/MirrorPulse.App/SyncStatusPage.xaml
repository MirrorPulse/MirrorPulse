<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MirrorPulse.App.SyncStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="32">
            <TextBlock Text="Sync status" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="OfflineNotice" IsOpen="False" Severity="Warning"
                     Title="Some Adapters are offline" IsClosable="False" />
            <TextBlock x:Name="PendingUploadsText" Text="Pending uploads: —" />
            <TextBlock x:Name="PendingConflictsText" Text="Pending remote conflicts: —" />
            <Button Content="Refresh" Click="RefreshButton_Click" HorizontalAlignment="Left" />
            <Button Content="Notifications" Click="NotificationsButton_Click" HorizontalAlignment="Left" />
            <ListView x:Name="InstanceStatusList" SelectionMode="None" />
            <TextBlock x:Name="StatusMessageText" TextWrapping="Wrap" Opacity="0.75" />
        </StackPanel>
    </ScrollViewer>
</Page>
