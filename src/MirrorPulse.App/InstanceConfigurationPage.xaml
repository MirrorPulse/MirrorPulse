<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MirrorPulse.App.InstanceConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="32" MaxWidth="760">
            <TextBlock Text="Configure Adapter instance" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="AdapterNameText" TextWrapping="Wrap" />
            <TextBlock Text="Choose where this Adapter reads files and how its folders appear in MirrorPulse." TextWrapping="Wrap" />
            <TextBox x:Name="AdapterLabelTextBox" Header="Instance name" />
            <TextBox x:Name="SourcePathTextBox" Header="Source" />
            <TextBox x:Name="UsernameTextBox" Header="Username" Visibility="Collapsed" />
            <PasswordBox x:Name="SecretBox" Header="Password or token" Visibility="Collapsed" />
            <TextBlock x:Name="SecretHintText" TextWrapping="Wrap" Opacity="0.75" Visibility="Collapsed" />
            <StackPanel x:Name="ConfigurationFieldsPanel" Spacing="12" />
            <StackPanel x:Name="RootLabelsPanel" Spacing="12" />
            <TextBox x:Name="AdditionalConfigurationTextBox" Header="Additional non-secret settings (JSON)"
                     PlaceholderText="Enter string settings as JSON" TextWrapping="Wrap"
                     AcceptsReturn="True" MinHeight="80" />
            <ToggleSwitch x:Name="StartWithMirrorPulseToggle" Header="Start this instance with MirrorPulse" IsOn="True" />
            <TextBlock Text="New instances start after MirrorPulse is restarted." TextWrapping="Wrap" Opacity="0.75" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="CreateButton" Content="Create instance" Click="CreateButton_Click" />
                <Button Content="Cancel" Click="CancelButton_Click" />
            </StackPanel>
            <InfoBar x:Name="ConfigurationStatusBar" IsOpen="False" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
