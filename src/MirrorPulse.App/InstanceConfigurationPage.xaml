<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MirrorPulse.App.InstanceConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="32" MaxWidth="760">
            <TextBlock Text="Configure Adapter instance" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="StepText" Text="Step 1 of 3: Choose a source" />
            <ProgressBar x:Name="ConfigurationProgress" Minimum="0" Maximum="3" Value="1" />
            <TextBox x:Name="AdapterLabelTextBox" Header="Adapter label" PlaceholderText="Shown in your MirrorPulse folder" />
            <TextBox x:Name="SourcePathTextBox" Header="Source path" PlaceholderText="https://server.example/share" />
            <TextBox x:Name="CredentialReferenceTextBox" Header="Credential reference (optional)" PlaceholderText="Credential stored by MirrorPulse" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BackButton" Content="Back" Click="BackButton_Click" />
                <Button x:Name="NextButton" Content="Next" Click="NextButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
