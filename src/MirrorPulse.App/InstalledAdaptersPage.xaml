<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MirrorPulse.App.InstalledAdaptersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="32">
            <TextBlock Text="Installed Adapters" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Manage the adapters that provide your MirrorPulse locations." TextWrapping="Wrap" />
            <Button Content="Sync status" Click="SyncStatusButton_Click" HorizontalAlignment="Left" />
            <ListView x:Name="InstalledAdaptersList" SelectionMode="None" />
            <TextBlock x:Name="EmptyStateText" Text="No Adapters are installed yet." Opacity="0.75" />
        </StackPanel>
    </ScrollViewer>
</Page>
