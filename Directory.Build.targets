<Project>
  <PropertyGroup>
    <RepositoryName>MirrorPulse</RepositoryName>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</RepositoryRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'MirrorPulse.App' or '$(MSBuildProjectName)' == 'MirrorPulse.Cli' or '$(MSBuildProjectName)' == 'MirrorPulse.Host'">
    <Content Include="$(RepositoryRoot)LICENSE;$(RepositoryRoot)NOTICE;$(RepositoryRoot)docs\third-party-notices.md">
      <Link>ThirdParty\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(RepositoryRoot)docs\dependencies\**\*">
      <Link>ThirdParty\dependencies\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateMirrorPulseTargetFramework" BeforeTargets="BeforeBuild">
    <Error Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'" Text="MirrorPulse projects must target .NET." />
  </Target>
</Project>
